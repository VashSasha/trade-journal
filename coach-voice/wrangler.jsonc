{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nvzn-coach-voice",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "VOICE_ENABLED": "true",
    "VOICE_DAILY_TOKEN_LIMIT": "50000",
    "APP_ORIGIN": "https://nvzn-journal.com",
    "SUPABASE_URL": "https://elbcjsewyqptrckdydha.supabase.co",
    "VOICE_MODEL": "gpt-realtime-mini"
  },
  "durable_objects": { "bindings": [{ "name": "VOICE_SESSIONS", "class_name": "CoachVoiceSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoachVoiceSession"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "dev": { "port": 8788 }
}
